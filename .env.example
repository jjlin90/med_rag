# ============================================================
# 环境变量模板：复制为 .env 后填写真实值
#   cp .env.example .env
# 注意：.env 已在 .gitignore 中屏蔽，请勿把真实密钥提交到 git。
# ============================================================

# ---------- LLM（必填，模型必须与接口供应商匹配） ----------
# OpenAI 兼容接口的密钥与地址。示例为阿里云 DashScope 兼容模式：
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus
LLM_GROUNDING=true

# ---------- Ragas 裁判参数（沿用上述 LLM 接口与模型） ----------
LLM_JUDGE_TEMPERATURE=0.0
LLM_JUDGE_TIMEOUT=180
LLM_JUDGE_MAX_TOKENS=2048
LLM_JUDGE_MAX_RETRIES=2
LLM_JUDGE_DISABLE_THINKING=true
LLM_JUDGE_JSON_MODE=false

# ---------- 独立配对评测脚本（scripts/eval_f_ar_single_judge_210.py） ----------
# 此脚本固定使用智谱接口，LLM_API_KEY 须匹配该供应商。
# 以下为脚本默认值；与上面的 Ragas 配置互不替代。
EVAL_JUDGE=glm-4.5-air
EVAL_MAX_TOKENS=1024

# ---------- Redis（可选，但本机 Docker 版需要密码） ----------
# Redis 密码：本机若用 Docker 容器 milvus-redis（启动带 --requirepass），必须填 1234，
# 否则 CacheManager 连不上（Authentication required），健康页 Redis 显示红、降级为无缓存模式。
# 不使用密码版 Redis 时留空即可。
REDIS_PASSWORD=1234

# ---------- 中间件（Config 支持以下环境变量） ----------
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DB_NAME=MED
MILVUS_CONN_ALIAS=MED
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace_with_your_local_password
MYSQL_DATABASE=medical_rag
