# ============================================================
# 环境变量模板：复制为 .env 后填写真实值
#   cp .env.example .env
# 注意：.env 已在 .gitignore 中屏蔽，请勿把真实密钥提交到 git。
# ============================================================

# ---------- LLM（必填，settings.py 实际只读取这两个） ----------
# OpenAI 兼容接口的密钥与地址。示例为阿里云 DashScope 兼容模式：
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---------- Redis（可选，但本机 Docker 版需要密码） ----------
# Redis 密码：本机若用 Docker 容器 milvus-redis（启动带 --requirepass），必须填 1234，
# 否则 CacheManager 连不上（Authentication required），健康页 Redis 显示红、降级为无缓存模式。
# 不使用密码版 Redis 时留空即可。
REDIS_PASSWORD=1234

# ---------- 说明 ----------
# 以下中间件地址目前在代码中写死为 localhost（见各模块 __init__），
# 暂不通过环境变量配置；如需外部化，请修改对应模块：
#   Milvus:  localhost:19530   (src/offline_pipeline/milvus_store.py)
#   Redis:   localhost:6379    (src/online_service/cache_manager.py，密码由 REDIS_PASSWORD 指定)
#   MySQL:   localhost:3306    (src/online_service/faq_search.py)
# LLM 模型名、温度等在 src/config/settings.py 中配置（LLM_MODEL_NAME 等）。
